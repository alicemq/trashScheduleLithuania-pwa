# API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT=5000
VITE_API_VERSION=v1

# Application Settings
VITE_APP_TITLE="Trash Schedule App"
VITE_APP_DESCRIPTION="Lithuanian Trash Collection Schedule with iCal Integration"
VITE_APP_DEFAULT_LOCALE=lt
VITE_APP_FALLBACK_LOCALE=en

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=false

# iCal Feed Settings
VITE_ICAL_FEED_BASE_URL=http://localhost:3000/ical
VITE_ICAL_FEED_CACHE_DURATION=3600
VITE_ICAL_FEED_REFRESH_INTERVAL=300
VITE_ICAL_FEED_MAX_EVENTS=100

# Calendar Settings
VITE_CALENDAR_DEFAULT_VIEW=month
VITE_CALENDAR_WORKING_HOURS_START=8
VITE_CALENDAR_WORKING_HOURS_END=18
VITE_CALENDAR_WEEKEND_DAYS="6,0"

# Cache Settings
VITE_CACHE_ENABLED=true
VITE_CACHE_DURATION=3600
VITE_CACHE_PREFIX=trash_schedule_

# Security Settings
VITE_CORS_ENABLED=true
VITE_RATE_LIMIT_ENABLED=true
VITE_RATE_LIMIT_MAX_REQUESTS=100
VITE_RATE_LIMIT_WINDOW_MS=900000

# Development Settings
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_HTTPS=false
VITE_DEV_SERVER_OPEN=true

# Build Settings
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=true
VITE_BUILD_TARGET=esnext
VITE_BUILD_ASSETS_DIR=assets 